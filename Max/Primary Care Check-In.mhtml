@charset "utf-8";

body { font: 16px / 1.5 system-ui, sans-serif; background: rgb(242, 246, 25=
0); color: rgb(20, 43, 64); margin: 0px; }

main { max-width: 780px; margin: 35px auto; background: white; padding: 30p=
x; border-radius: 16px; box-shadow: rgba(23, 49, 73, 0.094) 0px 8px 30px; }

h1 { margin-bottom: 4px; }


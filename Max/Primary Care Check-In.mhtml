-bottom: 7px; }

p { color: rgb(67, 85, 104); }

.field { margin: 18px 0px; }

label.question { display: block; font-weight: 650; margin-bottom: 7px; }

input:not([type=3D"checkbox"]):not([type=3D"radio"]), select, textarea { bo=
x-sizing: border-box; width: 100%; padding: 10px; border: 1px solid rgb(156=
, 176, 192); border-radius: 7px; font: inherit; }

textarea { min-height: 75px; }

.choice { display: block; padding: 5px 0px; }

button { background: rgb(21, 93, 135); color: white; border: 0px; border-ra=
dius: 8px; padding: 12px 18px; font-size: 16px; cursor: pointer; }

button.secondary { background: rgb(86, 108, 123); }

button:focus, input:focus, textarea:focus, select:focus { outline: rgb(154,=
 210, 242) solid 3px; }

small { display: block; color: rgb(82, 103, 123); }

.banner { background: rgb(233, 244, 251); border-left: 4px solid rgb(38, 12=
1, 173); padding: 12px; }

.actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }

@media (max-width: 650px) {
  main { margin: 0px; padding: 16px; border-radius: 0px; }
}

@media print {
  .actions, .banner { display: none; }
  main { box-shadow: none; }
}

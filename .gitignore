tools/plain_language/data/raw/
tools/plain_language/data/medical_vocab.txt
tools/translation/models/
tools/voice/models/

# Generated files
tools/plain_language/output/
scripts/video/build/
scripts/presentation/build/

# macOS and Office lock files
.DS_Store
~$*
